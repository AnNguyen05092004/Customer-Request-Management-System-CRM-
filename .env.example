# Optional overrides for the root full-stack compose.yaml.
POSTGRES_DB=bzcom_crm
POSTGRES_USER=bzcom
POSTGRES_PASSWORD=bzcom_local_password
POSTGRES_HOST_PORT=5433
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=5173
JWT_SECRET=replace-with-at-least-32-random-characters
LLM_ENABLED=false
GEMINI_API_KEY=

# Full stack uses the real Request API. Set demo explicitly only for isolated UI work.
VITE_REQUEST_DATA_MODE=api
